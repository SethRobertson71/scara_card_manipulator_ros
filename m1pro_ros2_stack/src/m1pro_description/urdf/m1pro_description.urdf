<?xml version="1.0" encoding="utf-8"?>
<!--
  M1Pro URDF for ROS2/MoveIt2
  Joint ordering matches SolidWorks export:
    joint1 = prismatic Z slide  (physical J3): 0 to 0.245m
    joint2 = base rotation      (physical J1): -85 to +85 deg
    joint3 = elbow rotation     (physical J2): -135 to +135 deg
    joint4 = end-effector rot   (physical J4): -360 to +360 deg
  Limits sourced from controller structure.json
-->
<robot name="m1pro_description">

  <link name="dummy_link" />
  <joint name="dummy_joint" type="fixed">
    <parent link="dummy_link" />
    <child  link="base_link" />
  </joint>

  <link name="base_link">
    <inertial>
      <origin xyz="0.0020887 0.24592 -9.2948E-06" rpy="0 0 0" />
      <mass value="1.6489" />
      <inertia ixx="0.090971" ixy="0.002094"   ixz="-4.8449E-06"
               iyy="0.009863" iyz="1.4427E-05"  izz="0.089585" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://m1pro_description/meshes/base_link.STL" /></geometry>
      <material name=""><color rgba="0.79216 0.81961 0.93333 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://m1pro_description/meshes/base_link.STL" /></geometry>
    </collision>
  </link>

  <link name="Link1">
    <inertial>
      <origin xyz="0.096709 6.1822E-05 0.090051" rpy="0 0 0" />
      <mass value="0.34234" />
      <inertia ixx="0.0016183" ixy="1.9963E-06"  ixz="-0.00029873"
               iyy="0.0016941" iyz="8.0481E-07"   izz="0.00088121" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://m1pro_description/meshes/Link1.STL" /></geometry>
      <material name=""><color rgba="0.79216 0.81961 0.93333 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://m1pro_description/meshes/Link1.STL" /></geometry>
    </collision>
  </link>

  <!-- joint1: Z slide (physical J3), prismatic -->
  <joint name="joint1" type="prismatic">
    <origin xyz="-0.003 0 0.0959" rpy="0 0 0" />
    <parent link="base_link" />
    <child  link="Link1" />
    <axis xyz="0 0 1" />
    <limit lower="0.005" upper="0.245" effort="100" velocity="0.5" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <link name="Link2">
    <inertial>
      <origin xyz="0.11428 -2.1681E-05 0.038255" rpy="0 0 0" />
      <mass value="0.37995" />
      <inertia ixx="0.00096644" ixy="2.2955E-06"  ixz="-0.00059955"
               iyy="0.0031741"  iyz="-2.4057E-09"  izz="0.0027963" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://m1pro_description/meshes/Link2.STL" /></geometry>
      <material name=""><color rgba="0.79216 0.81961 0.93333 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://m1pro_description/meshes/Link2.STL" /></geometry>
    </collision>
  </link>

  <!-- joint2: base rotation (physical J1), revolute -->
  <joint name="joint2" type="revolute">
    <origin xyz="0.123 0 0.0099745" rpy="0 0 0" />
    <parent link="Link1" />
    <child  link="Link2" />
    <axis xyz="0 0 1" />
    <limit lower="-1.4835" upper="1.4835" effort="100" velocity="3.14" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <link name="Link3">
    <inertial>
      <origin xyz="0.097934 0.00036211 0.0056251" rpy="0 0 0" />
      <mass value="0.33738" />
      <inertia ixx="0.00099637" ixy="-1.0881E-06" ixz="-0.00074781"
               iyy="0.003254"   iyz="-3.8055E-07"  izz="0.0025681" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://m1pro_description/meshes/Link3.STL" /></geometry>
      <material name=""><color rgba="0.79216 0.81961 0.93333 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://m1pro_description/meshes/Link3.STL" /></geometry>
    </collision>
  </link>

  <!-- joint3: elbow rotation (physical J2), revolute -->
  <joint name="joint3" type="revolute">
    <origin xyz="0.2 0 0" rpy="-0.017453 0 0.034228" />
    <parent link="Link2" />
    <child  link="Link3" />
    <axis xyz="0 0.017452 -0.99985" />
    <limit lower="-2.3562" upper="2.3562" effort="100" velocity="3.14" />
    <dynamics damping="0.1" friction="0.1" />
  </joint>

  <link name="Link4">
    <inertial>
      <origin xyz="3.505E-13 -1.5772E-11 -0.038921" rpy="0 0 0" />
      <mass value="0.010941" />
      <inertia ixx="7.2568E-06" ixy="4.4734E-21"  ixz="6.1388E-17"
               iyy="7.2589E-06" iyz="-4.5944E-15"  izz="4.4133E-07" />
    </inertial>
    <visual>
      <origin xyz="0 0 0.08081" rpy="0 0 0" />
      <geometry><mesh filename="package://m1pro_description/meshes/Link4.STL" /></geometry>
      <material name=""><color rgba="0.79216 0.81961 0.93333 1" /></material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://m1pro_description/meshes/Link4.STL" /></geometry>
    </collision>
  </link>

  <!-- joint4: end-effector rotation (physical J4), revolute -->
  <joint name="joint4" type="revolute">
    <origin xyz="0.2 0.00020895 -0.08081" rpy="0 0 0" />
    <parent link="Link3" />
    <child  link="Link4" />
    <axis xyz="0 0 1" />
    <limit lower="-6.2832" upper="6.2832" effort="50" velocity="6.28" />
    <dynamics damping="0.05" friction="0.05" />
  </joint>

</robot>
